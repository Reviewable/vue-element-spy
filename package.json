{
  "name": "vue-element-spy",
  "description": "Vue.js plugin for detecting when element reaches top of the viewport. The plugin uses Intersection Observer.",
  "version": "2.1.4",
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "update": "yarn up -R '*' && yarn dedupe --strategy highest",
    "latest": "yarn npm-check-updates -i -m --packageManager yarn --install never && yarn install",
    "build": "rollup -c rollup.config.js"
  },
  "type": "module",
  "main": "dist/vue-element-spy.umd.js",
  "module": "dist/vue-element-spy.esm.js",
  "unpkg": "dist/vue-element-spy.js",
  "files": [
    "dist/vue-element-spy.umd.js",
    "dist/vue-element-spy.esm.js",
    "dist/vue-element-spy.js"
  ],
  "repository": "https://github.com/Reviewable/vue-element-spy",
  "homepage": "https://github.com/Reviewable/vue-element-spy#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^24.0.1",
    "npm-check-updates": "^20.0.0",
    "rollup": "^3.18.0"
  },
  "keywords": [
    "Vue",
    "IntersectionObserver"
  ],
  "license": "MIT"
}
